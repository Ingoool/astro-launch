---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Home Page";
const description = "This is my home page for my new Astro site.";

const items = ["Dog", "Cat", "Platypus"];
---
<BaseLayout pageTitle={pageTitle} description={description}>

  	<h2>My awesome blog subtitle</h2>

  	<p>Some dynamic tests:</p>
<!-- HTML comment syntax is valid in .astro files -->
{/* JS comment syntax is also valid - but will not be seen in DOM */}

	<button id="button">Click Me</button>
	<script>
	function handleClick () {
		console.log("button clicked!");
	}
	document.getElementById("button")?.addEventListener("click", handleClick);
	</script>

	<ul>
	{items.map((item) => (
	<li>{item}</li>
	))}
	</ul>

</BaseLayout>