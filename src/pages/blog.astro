---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
const pageTitle = "My blog page";
const description = "This is my blog page for my new Astro site.";
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
---
<BaseLayout pageTitle={pageTitle} description={description}>

    <p>This is where I will post about my journey learning Astro.</p>

    <ul>
        <!-- List all blog posts with BlogPost Component -->
       {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
    </ul>

</BaseLayout>